# Emporix API Configuration - Automated Testing
NEXT_EMPORIX_TEST_BASE_URL=https://api.emporix.io
NEXT_EMPORIX_TEST_TENANT=showcasetest

# Emporix API Configuration - Storefront Key (less scope)
NEXT_PUBLIC_EMPORIX_BASE_URL=https://api.emporix.io
NEXT_PUBLIC_EMPORIX_TENANT=showcase

# Emporix API Configuration - Server-side (private)
NEXT_EMPORIX_BASE_URL=https://api.emporix.io
NEXT_EMPORIX_TENANT=showcase

# Client Credentials must be supplied as part of the Build-Process
# =============================================================================
# SENSITIVE CONFIGURATION (Secrets, Passwords, Private Keys)
# These values should never be committed or shared
# =============================================================================

# Authentication & Security
# ------------------------
# Required
NEXTAUTH_SECRET=your_nextauth_secret
NEXT_EMPORIX_CLIENT_SECRET=your_server_client_secret
NEXT_PUBLIC_EMPORIX_CLIENT_SECRET=your_client_secret_for_public_use

# Optional
NEXT_SETUP_API_SECRET=your_secure_setup_api_secret
VAPID_PRIVATE_KEY=your_generated_private_vapid_key
NEXT_PUBLIC_BATTERY_INCLUDED_API_KEY=your_battery_included_api_key
NEXT_PUBLIC_STORYBLOK_ACCESS_TOKEN=your_storyblok_access_token

# Test Environment Secrets
# -----------------------
# Required for automated testing
NEXT_EMPORIX_TEST_CLIENT_SECRET=your_server_client_secret
NEXT_EMPORIX_TEST_SERVER_CLIENT_SECRET=your_server_client_secret

# =============================================================================
# ENVIRONMENT-SPECIFIC CONFIGURATION
# Values that vary between environments but aren't sensitive
# =============================================================================

# Base URLs & Endpoints
# -----------------------
# Required
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_EMPORIX_BASE_URL=https://api.emporix.io
# -----------------------
# Optional
NEXT_PUBLIC_BATTERY_INCLUDED_BASE_URL=https://api.batteryincluded.com
# -----------------------
# Required for automated testing
NEXT_EMPORIX_TEST_BASE_URL=https://api.emporix.io

# Tenant & Client Configuration
# ------------------------
# Required
NEXT_PUBLIC_EMPORIX_TENANT=your_tenant_name
NEXT_PUBLIC_EMPORIX_CLIENT_ID=your_client_id_for_public_use
NEXT_EMPORIX_CLIENT_ID=your_server_client_id

# Required for automated testing
NEXT_EMPORIX_TEST_TENANT=your_tenant_name
NEXT_EMPORIX_TEST_CLIENT_ID=your_server_client_id
NEXT_EMPORIX_TEST_SERVER_CLIENT_ID=your_server_client_id

# =============================================================================
# GENERAL CONFIGURATION
# Default settings and feature flags
# =============================================================================

# System Defaults
# -------------
# Required
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_SITE=main
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_DEFAULT_COUNTRY=DE
NEXT_PUBLIC_DEFAULT_REGION=Europe
NEXT_PUBLIC_EMPORIX_DEFAULT_UNIT_CODE=piece

# Optional
NEXT_PUBLIC_AVAILABLE_SITES=main,us-branch
NEXT_PUBLIC_CART_COOKIE=your_cart_cookie_id
NEXT_PUBLIC_AUTH_COOKIE=your_auth_cookie_id
NEXT_PUBLIC_BATTERY_INCLUDED_COLLECTION=your_collection_name

# Feature Flags & Settings
# ----------------------
# Optional
NEXT_PUBLIC_STYLEGUIDE_PAGE=true
NEXT_PUBLIC_STORYBLOK_ACCESS_PREVIEW=true
NEXT_PUBLIC_STORYBLOK_MULTI_SITE=false
NEXT_PUBLIC_ROBOTS_NOINDEX=false
NEXT_SETUP_API_ENABLED=false
NEXT_PUBLIC_DISABLE_PUSH_NOTIFICATIONS=true
NEXT_CART_STOCK_CHECK_ENABLED=true

# Debug Settings
# ------------
# Optional
NEXT_PUBLIC_DEBUG_API_CURL=false
NEXT_PUBLIC_DEBUG_API_VERBOSE=false
NEXT_PUBLIC_DEBUG_API_ENDPOINTS=
NEXT_PUBLIC_DEBUG_API_RESPONSE=OFF

# Storage Configuration
# -------------------
# Optional
NEXT_PUBLIC_HISTORY_STORAGE_NAME=history-storage
NEXT_PUBLIC_MAX_SEARCH_HISTORY=10
NEXT_PUBLIC_MAX_LAST_SEEN_PRODUCTS=12

# Rate Limiting
# -----------
# Optional
RATE_LIMIT=60
RATE_WINDOW=60

# Security Headers
# --------------
# Optional
CROSS_ORIGIN_RESOURCE_POLICY=same-site
CROSS_ORIGIN_OPENER_POLICY=same-origin
X_CONTENT_TYPE_OPTIONS=nosniff
REFERRER_POLICY=no-referrer
X_XSS_PROTECTION=1; mode=block
STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains; preload

# Push Notifications
# ---------------
# Optional
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_generated_public_vapid_key
VAPID_CONTACT=mailto:example@support.com
NEXT_PUBLIC_NOTIFICATION_POLLING_INTERVAL_SECONDS=30

# Setup Steps
# ---------
# Optional
NEXT_SETUP_STEP_SERVICES=NotificationSetupStepService
